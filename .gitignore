CMakeLists.txt.user
# local presets of a developer, next to the shared CMakePresets.json
CMakeUserPresets.json
**/.DS_Store
*~
*.dbc
build/*
notes/*
.windsurf/
.idea/
# the vendoring update scripts (from/simdutf, from/webview, libs/uap-cpp/uap-core) keep
# the previous version as .last and the change as .diff - never commit those
from/simdutf/*.last
from/simdutf/*.diff
from/webview/*.last
from/webview/*.diff
from/cldr/*.last
from/cldr/*.diff
libs/uap-cpp/uap-core/*.last
libs/uap-cpp/uap-core/*.diff
