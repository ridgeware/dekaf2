#!/bin/bash

#%
#% bootstrap - pull, build and install dekaf2
#%
#% usage: bootstrap [<options>] go
#%
#% with <options>:
#%
#%   -with-debug : will install both debug and release versions
#%   -scratch    : clear the build directories of this run before building
#%                 (the vcpkg checkout in build/vcpkg stays)
#%   -no-pull    : do not pull the latest sources before building
#%   -no-setup   : do not install helper packages/libs
#%   -no-klog    : configure release build without klog
#%   -lto        : force link time optimization for release builds
#%   -static     : link against static third party libs (if available)
#%   -fresh      : recreate cmake build with fresh cache
#%   -j N        : build with N processes in parallel
#%                 (default is number of cpu cores)
#%   -vcpkg      : instead of the builds above, build dekaf2 for distribution:
#%                 static, with every library from vcpkg and none from the
#%                 system, installed into build/<triplet>/install - no sudo.
#%                 On macOS for Apple silicon from macOS 14 on (arm64-osx-14),
#%                 on Linux with vcpkg's triplet for the machine (x64-linux,
#%                 arm64-linux) - glibc stays the one of the build machine, so
#%                 the oldest distribution to run on is the one to build on.
#%                 vcpkg itself is checked out in build/vcpkg, at the
#%                 builtin-baseline of vcpkg/vcpkg.json. On Windows the same
#%                 comes from bootstrap.cmd
#%
#% The build directories will be subdirectories 'build/Release|Debug|Xcode'
#% (with -vcpkg 'build/<triplet>') of the directory in which this script is
#% located.
#%

# are we in test mode?
if [ "$1" = "-x" ]; then
	set -x
	shift
fi # end check test mode

setx=Install
#==================
Install ()
#==================
{
	local BuildType="$1"

	cd ${BuildType} || Die "Cannot cd into build directory ${BuildType}"

	# install

	Info "now installing dekaf2 ${BuildType} project (may need root password)"
	sudo cmake --build . --target install --config ${BuildType} | grep -v "Up-to-date"

	Info "dekaf2 ${BuildType} build successfully installed"

	cd ..

} # Install

setx=Build
#==================
Build ()
#==================
{
	local BuildType="$1"

	cd ${BuildType} || Die "Cannot cd into build directory ${BuildType}"

	# build

	Info "now building dekaf2 ${BuildType} project with ${CPUCORES} processes"
	cmake --build . --parallel ${CPUCORES} --target all --config ${BuildType} || Die "Cannot build ${BuildType} project"

	cd ..

} # Build

setx=Configure
#==================
Configure ()
#==================
{
	local BuildType="$1"
	shift
	local AdditionalParameters=$*

	cd ${BuildType} || Die "Cannot cd into build directory ${BuildType}"

	if [[ "${BuildType}" == "Xcode" ]]; then
		local BuildCommand="cmake -G Xcode"
	else
		local BuildCommand="cmake -DCMAKE_BUILD_TYPE=${BuildType}"
	fi

	# configure CMake

	Info "${SETMODERNCC} ${BuildCommand} ${AdditionalParameters} ${ME_ONLYPATH}"

	${SETMODERNCC} ${BuildCommand} ${AdditionalParameters} "${ME_ONLYPATH}" || Die "Cannot configure CMake project"

	cd ..

} # Configure

setx=VcpkgCheckout
#==================
VcpkgCheckout ()
#==================
{
	# vcpkg at the builtin-baseline of the manifest: the package hashes include vcpkg's
	# own scripts, so only this state finds the packages again in the binary cache
	# (~/.cache/vcpkg) - any other one builds them all anew

	local sBaseline
	sBaseline=$(sed -n 's/.*"builtin-baseline" *: *"\([0-9a-f]*\)".*/\1/p' "${ME_ONLYPATH}/vcpkg/vcpkg.json")
	[[ -n "${sBaseline}" ]] || Die "no builtin-baseline in ${ME_ONLYPATH}/vcpkg/vcpkg.json"

	if [[ ! -d "${VcpkgDir}/.git" ]]; then
		Info "cloning vcpkg into ${VcpkgDir}"
		git clone https://github.com/microsoft/vcpkg.git "${VcpkgDir}" || Die "Cannot clone vcpkg"
	fi

	if [[ "$(git -C "${VcpkgDir}" rev-parse HEAD)" != "${sBaseline}" ]]; then
		git -C "${VcpkgDir}" cat-file -e "${sBaseline}^{commit}" 2>/dev/null \
			|| git -C "${VcpkgDir}" fetch origin \
			|| Die "Cannot fetch vcpkg"
		Info "checking out vcpkg at ${sBaseline}"
		git -C "${VcpkgDir}" checkout -q "${sBaseline}" || Die "Cannot check out vcpkg at ${sBaseline}"
		# the tool belongs to the checkout
		rm -f "${VcpkgDir}/vcpkg"
	fi

	if [[ ! -x "${VcpkgDir}/vcpkg" ]]; then
		Info "bootstrapping vcpkg"
		"${VcpkgDir}/bootstrap-vcpkg.sh" -disableMetrics || Die "Cannot bootstrap vcpkg"
	fi

} # VcpkgCheckout

setx=VcpkgBuild
#==================
VcpkgBuild ()
#==================
{
	local sDir="${BuildDir}/${VcpkgTriplet}"
	local sGenerator=""
	command -v ninja >/dev/null 2>&1 && sGenerator="-G Ninja"

	VcpkgCheckout

	# the packages go into the build directory (manifest mode), and are restored
	# from the binary cache as long as vcpkg and the triplet are unchanged
	Info "configuring the vcpkg build in ${sDir}"
	${SETMODERNCC} cmake -S "${ME_ONLYPATH}" -B "${sDir}" ${sGenerator} \
		-DCMAKE_BUILD_TYPE=Release \
		-DDEKAF2_VCPKG_BUILD=ON \
		-DCMAKE_TOOLCHAIN_FILE="${VcpkgDir}/scripts/buildsystems/vcpkg.cmake" \
		-DVCPKG_MANIFEST_DIR="${ME_ONLYPATH}/vcpkg" \
		-DVCPKG_TARGET_TRIPLET="${VcpkgTriplet}" \
		-DCMAKE_INSTALL_PREFIX="${sDir}/install" \
		${sVcpkgOptions} ${sAdditionalOptions} \
		|| Die "Cannot configure the vcpkg build"

	Info "now building the dekaf2 vcpkg build with ${CPUCORES} processes"
	cmake --build "${sDir}" --parallel ${CPUCORES} || Die "Cannot build the vcpkg build"

	cmake --install "${sDir}" > /dev/null || Die "Cannot install the vcpkg build"
	Info "dekaf2 vcpkg build installed into ${sDir}/install"

} # VcpkgBuild

setx=Setup
#==================
Setup ()
#==================
{

	cd "${ME_ONLYPATH}"  || Die "Cannot cd into source directory ${ME_ONLYPATH}"

	if [[ ! -z "${bScratch}" ]]; then
		# only the directories of this run - not the vcpkg checkout
		local sDir
		for sDir in ${RunDirs}; do
			rm -rf "${BuildDir}/${sDir}" \
				&& Info "removed build directory ${BuildDir}/${sDir}" \
				|| Die "failed to remove build directory ${BuildDir}/${sDir}"
		done
	fi

	if [[ -d "${BuildDir}" ]]; then

		if [[ -z "${bScratch}" ]]; then
			Info "Build directory ${BuildDir} already setup."
			Info "Call ${ME} with -scratch to have a fresh build from scratch."
		fi

	else

		# create a pristine build directory

		mkdir "${BuildDir}" || Die "Cannot create build directory ${BuildDir}"

	fi

	if [[ -z "${bNoPull}" ]]; then
		Info "Checking for updates.."
		git pull         || Die "Cannot pull source code changes"
	fi

	if [[ ! -z "${bVcpkg}" ]]; then
		VcpkgBuild
		return
	fi

	cd "${BuildDir}"     || Die "Cannot cd into build directory ${BuildDir}"

	mkdir -p "Debug"     || Die "Cannot create Debug build directory"
	mkdir -p "Release"   || Die "Cannot create Release build directory"

	[[ ! -z "${bWithDebug}" ]] && Configure "Debug" ${sAdditionalOptions}
	Configure "Release" ${sAdditionalOptions}

    if [[ "${OS}" == "Darwin" ]]; then
        mkdir -p "Xcode" || Die "Cannot create Xcode build directory"
        Configure "Xcode" ${sAdditionalOptions}
    fi

	[[ ! -z "${bWithDebug}" ]] && Build "Debug"
	Build "Release"

	[[ ! -z "${bWithDebug}" ]] && Install "Debug"
	Install "Release"

} # Setup


#==================
setx=Main_Body
#==================

IMAYBE="${BASH_SOURCE:-$0}"
ME=$(basename "${IMAYBE}")
ME_ONLYPATH="$(cd $(dirname ${IMAYBE}) && pwd)"
ME_FULLPATH="$ME_ONLYPATH/$ME"
ScriptLib="${ME_ONLYPATH}/scripts/scriptlib"
BuildSetup="${ME_ONLYPATH}/scripts/buildsetup"
BuildDir="${ME_ONLYPATH}/build"
VcpkgDir="${BuildDir}/vcpkg"

[[ ! -f "${ScriptLib}" ]] && Die "Cannot check OS version, script '${ScriptLib}' not found"

source ${ScriptLib}

SetupColors
GetOS

case $(uname) in
Linux)
	CPUCORES=$(grep -E '^vendor_id' /proc/cpuinfo | wc -l)
	[[ $CPUCORES -eq 0 ]] && CPUCORES=$(grep -E '^processor' /proc/cpuinfo | wc -l)
	;;
Darwin)
	CPUCORES=$(expr $(sysctl -n hw.logicalcpu) / 1)
	;;
esac

# read arguments
while [[ $# -gt 0 ]]
do
	case "$1" in
	-help|--help|-h)
		Synopsis
		;;
	-with-debug|--with-debug)
		bWithDebug="1"
		;;
	-scratch|--scratch)
		bScratch="1"
		;;
	-nopull|-no-pull|--no-pull)
		bNoPull="1"
		;;
	-nosetup|-no-setup|--no-setup)
		bNoSetup="1"
		;;
	-no-klog|--no-klog)
		sAdditionalOptions="${sAdditionalOptions} -DDEKAF2_WITH_KLOG=OFF"
		;;
	-lto|--lto)
		sAdditionalOptions="${sAdditionalOptions} -DDEKAF2_LINK_TIME_OPTIMIZATION=ON"
		;;
	-static|--static)
		sAdditionalOptions="${sAdditionalOptions} -DDEKAF2_PREFER_STATIC_LIBS=ON"
		;;
	-fresh|--fresh)
		sAdditionalOptions="${sAdditionalOptions} --fresh"
		;;
	-j)
		shift
		CPUCORES=$1
		;;
	-vcpkg|--vcpkg)
		bVcpkg="1"
		;;
	-go|--go|go)
		bGo="1"
		;;
	*)
		Die "unknown option: '$1' -- try ${IMAYBE} -help"
		exit 1
		;;
	esac
	shift
done

[[ -z "${bGo}" ]] && Synopsis

[[ $CPUCORES -eq 0 ]] && CPUCORES=4

# the build directories of this run, cleared by -scratch
RunDirs="Debug Release Xcode"

if [[ ! -z "${bVcpkg}" ]]; then
	case "${OS}-${ARCH}" in
	Darwin-arm64)
		VcpkgTriplet="arm64-osx-14"
		# the minimum macOS of the triplet, for dekaf2 itself
		sMinMacOS=$(sed -n 's/^set(VCPKG_OSX_DEPLOYMENT_TARGET \([0-9.]*\))/\1/p' "${ME_ONLYPATH}/vcpkg/triplets/${VcpkgTriplet}.cmake")
		[[ -n "${sMinMacOS}" ]] || Die "no VCPKG_OSX_DEPLOYMENT_TARGET in vcpkg/triplets/${VcpkgTriplet}.cmake"
		sVcpkgOptions="-DCMAKE_OSX_DEPLOYMENT_TARGET=${sMinMacOS}"
		;;
	Linux-x86_64)
		VcpkgTriplet="x64-linux"
		;;
	Linux-aarch64|Linux-arm64)
		VcpkgTriplet="arm64-linux"
		;;
	*)
		Die "the vcpkg build is set up for macOS on Apple silicon, Linux on x86_64 and arm64 (and with bootstrap.cmd for Windows), not for ${OS} ${ARCH}"
		;;
	esac
	RunDirs="${VcpkgTriplet}"
fi

if [[ -z "${bNoSetup}" ]]; then
	[[ ! -f "${BuildSetup}" ]] && Die "Cannot setup build, script '${BuildSetup}' not found"
	"${BuildSetup}" ${bVcpkg:+-vcpkg} -go || Die "could not configure target machine"
fi

Setup

Info "dekaf2 successfully installed!"
