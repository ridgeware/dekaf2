{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "dekaf2",
  "version": "2.1.41",
  "description": "C++14/17/20/23 rapid application development framework",
  "homepage": "https://github.com/ridgeware/dekaf2",
  "license": "MIT",
  "dependencies": [
    "openssl",
    "zlib",
    "bzip2",
    "liblzma",
    "zstd",
    "brotli",
    "libzip",
    "yaml-cpp",
    "sqlite3",
    "libpq",
    "nghttp2",
    {
      "name": "ngtcp2",
      "features": [
        "openssl"
      ]
    },
    "nghttp3",
    "boost-asio",
    "boost-foreach",
    "boost-iostreams",
    "boost-multi-index",
    "boost-serialization",
    "boost-system",
    "fmt",
    "simdutf",
    "fast-float",
    "nlohmann-json",
    "libmariadb",
    {
      "$comment": "from ports/freetds (vcpkg-configuration.json), not vcpkg's own",
      "name": "freetds"
    },
    {
      "name": "webview2",
      "platform": "windows"
    }
  ],
  "overrides": [
    {
      "$comment": "the version that from/simdutf vendors, which is also the one of the baseline below - 8.1.0 to 9.2.0 write past the end of an output buffer of exactly binary_length_from_base64() when decoding base64 with white space (fixed in 9.2.1), so never pin a version from 8.1.0 to 9.2.0",
      "name": "simdutf",
      "version": "9.4.0"
    }
  ],
  "builtin-baseline": "0df93a05b9de080129e653ec4776d7e14a1b2e4f"
}
